# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
# Holds API_KEY, APP_SECRET and the mail/SMTP credentials for the OTP service.
# Deploy it straight to Hostinger; keep it out of the repo.
server/config.php

# Carries `apiKey`, the shared secret the OTP endpoints check. Copy
# app_config.example.dart to app_config.dart and paste the real key.
lib/config/app_config.dart

